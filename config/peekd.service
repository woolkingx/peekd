[Unit]
Description=peekd — per-process network monitor (eBPF)
Documentation=https://github.com/woolkingx/peekd
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/peekd daemon
Restart=on-failure
RestartSec=5

# Privileges — eBPF requires root or CAP_BPF + CAP_NET_ADMIN
User=root

# Logging — journal captures stdout/stderr; tracing writes to /var/log/peekd/
StandardOutput=journal
StandardError=journal
SyslogIdentifier=peekd

# Runtime directory
RuntimeDirectory=peekd
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
